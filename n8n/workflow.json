      "id": "15ab0107-7595-4ad6-8f3b-95882ea64c82",
      "name": "Gemini STT/Vision",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        -16,
        368
