        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\"contents\":[{\"parts\":[{\"text\":\"Transcreva o áudio ou descreva a imagem da ocorrência.\"},{\"inline_data\":{\"mime_type\":\"{{ $('To Base64').first().json.mimeType }}\",\"data\":\"{{ $('To Base64').first().json.base64 }}\"}}]}]}",
        "options": {}
