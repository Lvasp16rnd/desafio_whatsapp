      "parameters": {
        "jsCode": "const item = $input.first();\nconst keys = Object.keys(item.binary || {});\nconst field = keys[0];\nconst file = (item.binary || {})[field] || {};\nreturn [{ json: { base64: file.data || '', mimeType: file.mimeType || 'audio/ogg' } }];"
