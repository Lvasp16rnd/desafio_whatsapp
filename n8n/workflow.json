      "id": "6f66f666-6666-4666-8666-666666666666",
      "name": "Gemini STT/Vision",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [1540, -160]
    },
    {
      "parameters": {
        "jsCode": "const p = $('Parse Payload').first().json;\nlet saved = {};\nconst s = $('Read State').first();\nif (s && s.json && s.json.state) { saved = s.json; }\nelse if (s && s.json && s.json.value) { try { saved = JSON.parse(s.json.value) || {}; } catch (err) { saved = {}; } }\n\nconst type = p.type;\nlet transcription = '';\nconst g = $('Gemini STT/Vision').first();\nif (g && g.json) { transcription = g.json.transcription || (g.json.candidates || [{}])[0]?.content?.parts?.[0]?.text || ''; }\nconst text = type === 'text' ? p.text : transcription;\n\nconst currentState = saved.state || 'SAUDACAO';\nconst data = saved.data || {};\nlet nextState = currentState;\nlet reply = '';\nlet openTicket = false;\nlet needSearch = false;\n\nif (currentState === 'SAUDACAO') {\n  reply = 'Olá! Sou o assistente virtual. Para abrir seu chamado, envie um ÁUDIO com seu Nome, E-mail e Celular. Você também pode enviar imagem ou áudio da ocorrência.';\n  nextState = 'COLETA';\n} else if (currentState === 'COLETA') {\n  if (data.nome && data.email && data.celular) {\n    reply = 'Confirma os dados? Nome: ' + data.nome + ' | E-mail: ' + data.email + ' | Celular: ' + data.celular + '. Responda SIM para abrir o chamado ou NÃO para corrigir.';\n    nextState = 'CONFIRMACAO';\n  } else {\n    data.nome = data.nome || text;\n    reply = 'Recebi! Continue enviando os dados que faltam (Nome, E-mail e Celular).';\n    nextState = 'COLETA';\n  }\n} else if (currentState === 'CONFIRMACAO') {\n  if (String(text).toLowerCase().indexOf('sim') === 0) {\n    openTicket = true;\n    reply = 'Chamado aberto! Aguarde, um atendente humano entrará em contato. Se tiver alguma dúvida agora, pode me perguntar.';\n    nextState = 'CHAMADO';\n  } else {\n    reply = 'Sem problemas! Envie novamente um áudio com Nome, E-mail e Celular.';\n    nextState = 'COLETA';\n  }\n} else if (currentState === 'CHAMADO') {\n  needSearch = true;\n  nextState = 'ATENDIMENTO';\n  reply = 'Vou buscar uma resposta para sua dúvida...';\n} else if (currentState === 'ATENDIMENTO') {\n  if (String(text).toLowerCase().indexOf('sim') === 0) {\n    reply = 'Ótimo! Fico feliz em ajudar. Até logo!';\n    nextState = 'ENCERRADO';\n  } else {\n    needSearch = true;\n    nextState = 'ATENDIMENTO';\n    reply = 'Vou buscar novamente...';\n  }\n}\n\nreturn [{ json: { from: p.from, type, text, state: nextState, reply, openTicket, needSearch, data, stateJson: JSON.stringify({ state: nextState, data }) } }];"
      },
