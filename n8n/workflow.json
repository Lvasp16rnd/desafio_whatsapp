        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\\\"contents\\\":[{\\\"parts\\\":[{\\\"text\\\":\\\"Transcreva APENAS o conteúdo falado no áudio ou descreva somente a imagem. Não adicione introduções, títulos, saudações nem comentários. Responda somente com a transcrição/descrição.\\\"},{\\\"inline_data\\\":{\\\"mime_type\\\":\\\"{{ $('To Base64').first().json.mimeType }}\\\",\\\"data\\\":\\\"{{ $('To Base64').first().json.base64 }}\\\"}}]}]}",
