    {
      "parameters": {
        "jsCode": "const p = $('Parse Payload').first().json;\nlet saved = {};\nconst s = $('Read State').first();\nif (s && s.json) {\n  const raw = s.json.state || s.json.value || s.json.propertyName;\n  if (raw) {\n    if (typeof raw === 'string') { try { saved = JSON.parse(raw) || {}; } catch (e) { saved = {}; } }\n    else { saved = raw; }\n  }\n}\n\nconst type = p.type;\nlet transcription = '';\nif (type !== 'text') {\n  const g = $('Gemini STT/Vision').first();\n  if (g && g.json) { transcription = g.json.transcription || (g.json.candidates || [{}])[0]?.content?.parts?.[0]?.text || ''; }\n}\nconst text = type === 'text' ? p.text : transcription;\n\nfunction extrairEmail(t) {\n  const m = (t || '').match(/[\\w.+-]+@[\\w-]+\\.[\\w.-]+/);\n  return m ? m[0] : '';\n}\nfunction extrairCelular(t) {\n  const m = (t || '').match(/(\\+?\\d{2}[\\s.-]?)?(?:\\(?(\\d{2})\\)?[\\s.-]?)?(9?\\s?\\d{4}[\\s.-]?\\d{4}|\\d{4}[\\s.-]?\\d{4})/);\n  return m ? m[0].trim() : '';\n}\nfunction extrairNome(t, email, celular) {\n  let nome = '';\n  const m = (t || '').match(/(?:meu nome [ée]|sou(?: o| a)?|nome[:\\s]+)([^,.]+)/i);\n  if (m) { nome = m[1].trim(); }\n  if (!nome) {\n    const corte = (t || '').split(/[,.|]/)[0] || '';\n    nome = corte\n      .replace(/(meu nome [ée]|sou(?: o| a)?|meu email[^,]*|meu celular[^,]*|meu número[^,]*|celular[^,]*|email[^,]*)/gi, ' ')\n      .replace(email, ' ').replace(celular, ' ').replace(/\\s{2,}/g, ' ').trim();\n    if (nome.length < 3 || /\\d/.test(nome) && !/[a-zA-ZÀ-ÿ]/.test(nome)) { nome = ''; }\n  }\n  return nome;\n}\n\nconst currentState = saved.state || 'SAUDACAO';\nconst data = saved.data || { nome: '', email: '', celular: '', ocorrencia: '' };\nlet nextState = currentState;\nlet reply = '';\nlet openTicket = false;\nlet needSearch = false;\n\nif (currentState === 'SAUDACAO') {\n  reply = 'Olá! Sou o assistente virtual. Para abrir seu chamado, envie um ÁUDIO com seu Nome, E-mail e Celular. Você também pode digitá-los.';\n  nextState = 'COLETA';\n} else if (currentState === 'COLETA') {\n  const email = extrairEmail(text);\n  const celular = extrairCelular(text);\n  const nome = extrairNome(text, email, celular);\n  if (email) { data.email = email; }\n  if (celular) { data.celular = celular; }\n  if (nome) { data.nome = nome; }\n\n  const faltando = [];\n  if (!data.nome) { faltando.push('Nome'); }\n  if (!data.email) { faltando.push('E-mail'); }\n  if (!data.celular) { faltando.push('Celular'); }\n\n  if (faltando.length === 0) {\n    reply = 'Recebi! Confirme os dados: Nome: ' + data.nome + ' | E-mail: ' + data.email + ' | Celular: ' + data.celular + '. Responda SIM se estiver correto.';\n    nextState = 'CONFIRMACAO';\n  } else {\n    reply = 'Ainda falta: ' + faltando.join(', ') + '. Envie em um áudio ou digite, por favor.';\n    nextState = 'COLETA';\n  }\n} else if (currentState === 'CONFIRMACAO') {\n  if (String(text).toLowerCase().indexOf('sim') === 0) {\n    reply = 'Ótimo! Agora me conte qual é o problema. Envie um áudio, uma imagem ou digite a descrição da ocorrência.';\n    nextState = 'PROBLEMA';\n  } else {\n    data.nome = ''; data.email = ''; data.celular = '';\n    reply = 'Sem problemas! Envie novamente seu Nome, E-mail e Celular.';\n    nextState = 'COLETA';\n  }\n} else if (currentState === 'PROBLEMA') {\n  const limpo = String(text).replace(/^(meu problema [ée]|o problema [ée]|preciso|eu)/i, '').trim();\n  if (limpo.length >= 3) { data.ocorrencia = limpo; }\n  openTicket = true;\n  reply = 'Chamado aberto! Registramos sua ocorrência e um atendente humano entrará em contato. Aguarde.';\n  nextState = 'CHAMADO';\n} else if (currentState === 'CHAMADO') {\n  needSearch = true;\n  nextState = 'ATENDIMENTO';\n  reply = 'Vou buscar uma resposta para sua dúvida...';\n} else if (currentState === 'ATENDIMENTO') {\n  if (String(text).toLowerCase().indexOf('sim') === 0) {\n    reply = 'Ótimo! Fico feliz em ajudar. Até logo!';\n    nextState = 'ENCERRADO';\n  } else {\n    needSearch = true;\n    nextState = 'ATENDIMENTO';\n    reply = 'Vou buscar novamente...';\n  }\n}\n\nreturn [{ json: { from: p.from, type, text, state: nextState, reply, openTicket, needSearch, data, stateJson: JSON.stringify({ state: nextState, data }) } }];"
      },
