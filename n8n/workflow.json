      "parameters": {
        "jsCode": "const b = $json.body || $json;\nconst e = (b.entry || [])[0] || {};\nconst c = (e.changes || [])[0] || {};\nconst v = c.value || {};\nconst m = (v.messages || [])[0] || {};\nconst type = m.type || 'text';\nconst text = type === 'text' ? ((m.text || {}).body || '') : '';\nconst mediaId = (m.audio || {}).id || (m.image || {}).id || '';\nreturn [{ json: {\n  from: m.from || '',\n  name: ((v.contacts || [{}])[0].profile || {}).name || '',\n  type,\n  text,\n  mediaId,\n  timestamp: m.timestamp || ''\n} }];"
      },
