PHONE_NUMBER_ID=
VERIFY_TOKEN=

# ===== Google Gemini (Google AI Studio) =====
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# ===== DuckDNS + VM Oracle =====
