# ===== Meta WhatsApp Cloud API =====
# Pegue no painel do app Meta Developer (use case "Connect with customers through WhatsApp")
WHATSAPP_TOKEN=
PHONE_NUMBER_ID=
VERIFY_TOKEN=

# ===== Google Gemini (Google AI Studio) =====
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# ===== DuckDNS + VM Oracle =====
# Subdomínio usado na URL pública: https://agenteautomacao.duckdns.org
DUCKDNS_SUBDOMAIN=agenteautomacao
DUCKDNS_IP=

# ===== VM Oracle (ponte SSH reversa) =====
# Usuario default: opc (Oracle Linux) ou ubuntu (Ubuntu)
VM_USER=ubuntu
VM_HOST=
# Caminho da chave privada (.pem) usada no SSH reverso
VM_SSH_KEY=
